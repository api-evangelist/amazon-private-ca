              "mode": "raw",
              "raw": "{\n  \"CertificateAuthorityArn\": \"arn:Qhg.A9Fh@lj:/49eK:_JzIq:5:@DpxytUke/dCGk=Lx/ZMkTJ.t/-fIC/HRG2mb1K/9npoNeL.Q3/slbzNj./09l./QkWi/O4=21\",\n  \"PermanentDeletionTimeInDays\": \"<integer>\"\n}",
              "options": {
