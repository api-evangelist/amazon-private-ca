              "mode": "raw",
              "raw": "{\n  \"CertificateAuthorityArn\": \"arn:3W.cg19:/MrW:Iy@oqgpoc6:5:LCVF735/G.-Eg,lwv/jverH/QKG1i.=/tK1VHXI091/J8WgTu2_1vr/u/PMBM7Q5\",\n  \"Tags\": [\n    {\n      \"Key\": \"{\",\n      \"Value\": \"+Z@-+:L/N\"\n    }\n  ]\n}",
