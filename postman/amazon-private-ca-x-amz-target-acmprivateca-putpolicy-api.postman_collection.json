              "raw": "{\n  \"ResourceArn\": \"arn:Xv60S:z:LuzsW:105:SPZ/hLk_ONfs/ZSoPT/x_DK/+Rc@.=/iUEQ7H.E/A@q,/fecw+Y/AdglQMf/0VHssrj/6VV9M\",\n  \"Policy\": \"\u00cc\\t>!\u00c25\u00df\"\n}",
