              "mode": "raw",
              "raw": "{\n  \"CertificateAuthorityArn\": \"arn:F5dPUES:6R+__rwmWx:_:234:PsxLPTe97/g/bLH2t_/PYxH@B/JTjZ2l1Ce8/I2/MGDEBZ3.Euw/d1djdkQd/Y5a/5n_zhUwof\",\n  \"RevocationConfiguration\": {\n    \"CrlConfiguration\": {\n      \"Enabled\": \"<boolean>\",\n      \"ExpirationInDays\": \"<integer>\",\n      \"CustomCname\": \"77)D\",\n      \"S3BucketName\": \"CrCr\",\n      \"S3ObjectAcl\": \"PUBLIC_READ\"\n    },\n    \"OcspConfiguration\": {\n      \"Enabled\": \"<boolean>\",\n      \"OcspCustomCname\": \"RU\"\n    }\n  },\n  \"Status\": \"ACTIVE\"\n}",
