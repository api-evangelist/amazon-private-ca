              "mode": "raw",
              "raw": "{\n  \"CertificateAuthorityArn\": \"arn:CmJH+zy5tW:lZ5xc:2-r:5742287:8mMQ/IYfUH/c4F/f1elhrNbDz./ypEDi7uX7fK/PuOkG5zfzsV/Ukv37k\",\n  \"Principal\": \"=8q:T=8,{+y\",\n  \"SourceAccount\": \"340134013401\"\n}",
              "options": {
